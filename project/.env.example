# ========================================
# AgentNet-DA 环境配置
# 复制为 .env 并修改
# ========================================

# LLM Backend: "dashscope" (阿里云API) or "ollama" (本地)
LLM_BACKEND=dashscope

# --- DashScope API (LLM_BACKEND=dashscope) ---
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- Ollama Local (LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# Embedding (本地)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Agent
AGENT_COUNT=4
AGENT_MAX_ITERATIONS=20
AGENT_FORWARD_PATH_MAX_LENGTH=3

# Experience Pool
POOL_SIZE=50
POOL_RETRIEVAL_COUNT=3
POOL_EMBEDDING_CACHE_LIMIT=1000
POOL_DECAY_RATE=0.1
POOL_DECAY_INTERVAL=10

# Paths
OUTPUT_DIR=./outputs
DATA_DIR=./data
